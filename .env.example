# Host do Cloudera Manager (sem protocolo e sem porta)
CM_HOST=cm01.cliente.local

# Porta: vazio = 7183 com TLS, 7180 sem TLS
CM_PORT=

# TLS
CM_USE_TLS=true
# true | false | caminho para o CA bundle (ex.: /etc/pki/tls/certs/ca-bundle.crt)
CM_VERIFY_SSL=true

# Usuário dedicado com role Read-Only no CM
CM_USERNAME=mcp_readonly
CM_PASSWORD=troque-me

# Versão da API (ex.: v51). Vazio = autodetectar via /api/version
CM_API_VERSION=

# Timeout das chamadas (segundos) e limite de caracteres por resposta
CM_TIMEOUT=30
CM_MCP_MAX_CHARS=60000

# --- YARN ResourceManager (opcional) ---
# Vazio = descobre o RM ativo pelo CM
YARN_RM_URL=
# none | basic (Knox) | kerberos (requer pip install -e '.[kerberos]' e kinit)
YARN_RM_AUTH=none
YARN_RM_USERNAME=
YARN_RM_PASSWORD=
# YARN_RM_TLS=true
# YARN_RM_PORT=8090
# YARN_RM_VERIFY_SSL=true

# Somente para o modo HTTP
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
